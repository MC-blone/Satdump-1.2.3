prefix=/tmp/sattool/android/deps/output/arm64-v8a
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libtiff
Description:  Tag Image File Format (TIFF) library.
Version: 4.6.0
Libs: -L${libdir} -ltiff
Libs.private:  -lm
Cflags: -I${includedir}
Requires.private:  zlib
