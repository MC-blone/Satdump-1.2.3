prefix=/tmp/sattool/android/deps/output/x86_64
exec_prefix=${prefix}
libdir=/tmp/sattool/android/deps/output/x86_64/lib
includedir=${prefix}/include
supported_protocols="HTTP HTTPS IPFS IPNS"
supported_features="alt-svc AsynchDNS HSTS IPv6 Largefile libz NTLM SSL threadsafe UnixSockets"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with ftp, http, etc.
Version: 8.9.1-DEV
Requires: 
Requires.private: wolfssl,zlib
Libs: -L${libdir} -lcurl 
Libs.private:  -l:libunwind.a -ldl -lc -l:libunwind.a -ldl -pthread -lwolfssl -L/usr/local/lib/android/sdk/ndk/25.2.9519653/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/x86_64-linux-android/24 -lz
Cflags: -I${includedir} 
